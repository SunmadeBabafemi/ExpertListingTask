NODE_ENV=development
PORT=3000

# PostgreSQL with the PostGIS extension available (the first migration enables it)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/expert-listing
DB_SSL=false
DB_LOGGING=false

# Optional. e2e tests default to DATABASE_URL with a "-test" suffix on the db name
# (created automatically). Tests TRUNCATE tables, so never point this at real data.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/expert-listing-test

# Optional. Without it an in-process cache is used (fine for a single instance)
# REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60
